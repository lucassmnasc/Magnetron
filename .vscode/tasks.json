{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug",
            "type": "process",
            "command": "make",
            "windows": {
                "command": "mingw32-make.exe",
                "args": [
                    "config=debug_x64"
                ]
            },
            "linux": {
                "args": [
                    "config=debug_x64"
                ]
            },
            "osx": {
                "args": [
                    "config=debug_arm64"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "UpdateMake"
            ]
        },
        {
            "label": "build debug no premake",
            "type": "process",
            "command": "make",
            "windows": {
                "command": "mingw32-make.exe",
                "args": [
                    "config=debug_x64"
                ]
            },
            "linux": {
                "args": [
                    "config=debug_x64"
                ]
            },
            "osx": {
                "args": [
                    "config=debug_arm64"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build release",
            "type": "process",
            "command": "make",
            "windows": {
                "command": "mingw32-make.exe",
                "args": [
                    "config=release_x64"
                ]
            },
            "linux": {
                "args": [
                    "config=release_x64"
                ]
            },
            "osx": {
                "args": [
                    "config=release_arm64"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "UpdateMake"
            ]
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "make",
            "windows": {
                "command": "mingw32-make.exe",
                "args": [
                    "clean"
                ]
            },
            "linux": {
                "args": [
                    "clean"
                ]
            },
            "osx": {
                "args": [
                    "clean"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "UpdateMake"
            ]
        },
        {
            "label": "Setup Project (Premake + Clean)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "UpdateMake",
                "Clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "UpdateMake",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "windows": {
                "command": ".\\premake5.exe",
                "args": [
                    "gmake"
                ]
            },
            "linux": {
                "command": "chmod +x ./premake5 && ./premake5 gmake"
            },
            "osx": {
                "command": "chmod +x ./premake5.osx && ./premake5.osx gmake"
            },
            "group": "build",
            "problemMatcher": [],
            "dependsOn": [
                "Generate compile_commands.json"
            ]
        },
        {
            "label": "Generate IDE Project (VS2022 / Xcode / Make)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "windows": {
                "command": ".\\premake5.exe",
                "args": [
                    "vs2022"
                ]
            },
            "linux": {
                "command": "chmod +x ./premake5 && ./premake5 gmake"
            },
            "osx": {
                "command": "chmod +x ./premake5.osx && ./premake5.osx xcode4"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Generate VS2026 Project (VS2026 / Xcode / Make)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "windows": {
                "command": ".\\premake5.exe",
                "args": [
                    "vs2026"
                ]
            },
            "linux": {
                "command": "chmod +x ./premake5 && ./premake5 gmake"
            },
            "osx": {
                "command": "chmod +x ./premake5.osx && ./premake5.osx xcode4"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Generate compile_commands.json",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "windows": {
                "command": ".\\premake5.exe",
                "args": [
                    "ecc"
                ]
            },
            "linux": {
                "command": "chmod +x ./premake5 && ./premake5 ecc"
            },
            "osx": {
                "command": "chmod +x ./premake5.osx && ./premake5.osx ecc"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
